{
  "name": "inkwell-api",
  "version": "1.0.0",
  "private": true,
  "description": "Chapter 24 capstone: the Inkwell shop API (node:http + pg)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-db.js",
    "pretest": "node --env-file-if-exists=.env.test scripts/reset-db.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
