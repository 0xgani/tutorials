# Copy to .env and adjust: cp .env.example .env. Compose reads .env for ${...} interpolation.
# Only non-secret settings belong here; the database password is in secrets/db_password.txt.

# Development: nginx on unprivileged ports, with the certificate from ./create-dev-cert.sh.
HTTP_PORT=8080
HTTPS_PORT=8443

# Production (on the server), instead:
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# SNIP_IMAGE=registry.example.com/snip:1.10
# HTTP_PORT=80
# HTTPS_PORT=443
# CERTS_DIR=/etc/snip/certs
# ACME_DIR=/srv/snip/acme
